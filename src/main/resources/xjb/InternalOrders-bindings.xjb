        <!-- deliveryaddress/addressline1 (attribute) -->
        <jaxb:bindings node="//xs:element[@name='DeliveryAddress']//xs:attribute[@name='AddressLine1']">
            <jaxb:property name="addressLine1Attr"/>
        </jaxb:bindings>

        <!-- addressline2 -->
        <jaxb:bindings node="//xs:element[@name='DeliveryAddress']//xs:attribute[@name='AddressLine2']">
            <jaxb:property name="addressLine2Attr"/>
        </jaxb:bindings>

        <!-- addressline3 -->
        <jaxb:bindings node="//xs:element[@name='DeliveryAddress']//xs:attribute[@name='AddressLine3']">
            <jaxb:property name="addressLine3Attr"/>
        </jaxb:bindings>

        <!-- postalcode -->
        <jaxb:bindings node="//xs:element[@name='DeliveryAddress']//xs:attribute[@name='PostalCode']">
            <jaxb:property name="postalCodeAttr"/>
        </jaxb:bindings>

        <!-- city -->
        <jaxb:bindings node="//xs:element[@name='DeliveryAddress']//xs:attribute[@name='City']">
            <jaxb:property name="cityAttr"/>
        </jaxb:bindings>

        <!-- statecode -->
        <jaxb:bindings node="//xs:element[@name='DeliveryAddress']//xs:attribute[@name='StateCode']">
            <jaxb:property name="stateCodeAttr"/>
        </jaxb:bindings>

        <!-- countrycode -->
        <jaxb:bindings node="//xs:element[@name='DeliveryAddress']//xs:attribute[@name='CountryCode']">
            <jaxb:property name="countryCodeAttr"/>
        </jaxb:bindings>

    </jaxb:bindings>
</jaxb:bindings>



